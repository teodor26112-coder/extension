{
  "manifest_version": 3,
  "name": "Ozon Price Tracker",
  "description": "Отслеживайте цены товаров на Ozon, получайте графики и уведомления о снижении цен.",
  "version": "0.2.0",
  "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting", "tabs"],
  "host_permissions": ["https://www.ozon.ru/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ozon.ru/*"],
      "js": ["contentScript.js"],
      "css": ["contentScript.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Мониторинг цен Ozon",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["tracked.html", "tracked.js", "tracked.css", "ui-helpers.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
