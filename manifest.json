{
  "manifest_version": 3,
  "name": "Ozon Price Tracker",
  "description": "Отслеживайте цены товаров на Ozon и получайте уведомления при снижении стоимости.",
  "version": "0.1.0",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://www.ozon.ru/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Мониторинг цен Ozon",
    "default_popup": "popup.html"
  }
}
