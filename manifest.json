{
  "manifest_version": 3,
  "name": "PriceHunt",
  "version": "0.1.0",
  "description": "Browser extension that helps track and compare prices across supported stores.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*/", "http://*/"],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content-scripts/pricehunt.js"],
      "run_at": "document_idle"
    }
  ]
}
